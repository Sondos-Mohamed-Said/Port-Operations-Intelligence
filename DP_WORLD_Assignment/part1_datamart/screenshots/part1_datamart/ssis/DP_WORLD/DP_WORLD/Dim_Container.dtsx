                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT 
    CAST(container_no AS NVARCHAR(50)) AS container_no,
    ISNULL(TRY_CAST(container_size AS NVARCHAR(50)), 0) AS container_size,
    ISNULL(TRY_CAST(is_reefer AS INT), 0) AS is_reefer
FROM stg.ContainerMovements 
WHERE container_no IS NOT NULL;</property>
